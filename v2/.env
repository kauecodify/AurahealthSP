# ===========================================
# AuraHealthSP v2 - Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3002
APP_NAME=AuraHealthSP v2
APP_VERSION=2.0.0

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aurahealth_v2
DB_USER=aura
DB_PASSWORD=aura123
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# MEI Integration
MEI_API_URL=https://api.gateways.mei.gov.br/v2
MEI_API_KEY=your-mei-api-key
MEI_WEBHOOK_SECRET=your-mei-webhook-secret

# Satellite Integration
SATELLITE_API_URL=https://api.satellite-tracking.gov.br/v1
SATELLITE_API_KEY=your-satellite-api-key

# Ambulance Tracking
AMBULANCE_TRACKING_ENABLED=true
AMBULANCE_UPDATE_INTERVAL_MS=5000

# File Upload
UPLOAD_MAX_SIZE=50mb
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800

# Logging
LOG_LEVEL=info
LOG_FORMAT=combined

# Email (for proposal notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@aurahealthsp.gov.br

# Government API
GOVERNMENT_API_URL=https://api.gov.br/v1
GOVERNMENT_API_KEY=your-gov-api-key

# Contract Management
CONTRACT_EXPIRY_WARNING_DAYS=30
CONTRACT_AUTO_RENEWAL=false

# Budget
PRE_SEED_BUDGET=20000000
PRE_SEED_YEAR=2030

# Infrastructure Cost
INFRA_MONTHLY_COST=5000
INFRA_ANNUAL_COST=60000

# OldButGold TR8 Configuration
OLD_BUT_GOLD_ENABLED=true
OLD_BUT_GOLD_VERSION=tr8
OLD_BUT_GOLD_HIDDEN=true
